{
  "openapi": "3.1.0",
  "info": {
    "title": "Interseguro APIs",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Estado del proceso",
        "description": "Confirma que la API está en ejecución. Devuelve 200 cuando el proceso puede responder. En Go, esta comprobación funciona aunque Node no esté disponible.",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Disponibilidad para recibir solicitudes",
        "description": "En la API pública, comprueba que Go pueda comunicarse con el servicio de estadísticas. Devuelve 200 si Node responde correctamente o 503 si la dependencia no está disponible.",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Statistics dependency is unavailable (Go only)",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/matrices/qr": {
      "post": {
        "summary": "Factorización QR reducida",
        "description": "Recibe una matriz rectangular y devuelve los factores Q y R, las dimensiones originales y la convención usada. Q tiene columnas ortonormales y su producto con R reconstruye la entrada. Esta operación se calcula en Go.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "matrix": {
                    "$ref": "#/components/schemas/Matrix"
                  }
                },
                "required": [
                  "matrix"
                ]
              },
              "example": {
                "matrix": [
                  [
                    1,
                    2,
                    3
                  ],
                  [
                    4,
                    5,
                    6
                  ]
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QR"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds body limit",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid matrix or operation, or numeric overflow",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/matrices/rotate": {
      "post": {
        "summary": "Rotación de 90 grados en sentido horario",
        "description": "Recibe una matriz rectangular y devuelve la matriz girada junto con el ángulo aplicado. Por ejemplo, una matriz de 2 filas y 3 columnas pasa a tener 3 filas y 2 columnas. Esta operación se calcula en Go.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "matrix": {
                    "$ref": "#/components/schemas/Matrix"
                  },
                  "direction": {
                    "const": "clockwise"
                  }
                },
                "required": [
                  "matrix"
                ]
              },
              "example": {
                "matrix": [
                  [
                    1,
                    2,
                    3
                  ],
                  [
                    4,
                    5,
                    6
                  ]
                ],
                "direction": "clockwise"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Rotation"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds body limit",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid matrix or operation, or numeric overflow",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/matrices/analyze": {
      "post": {
        "summary": "Analizar una matriz y obtener estadísticas",
        "description": "Envía una matriz y selecciona qr o rotate. Go calcula los factores Q y R o la matriz rotada, y envía ese resultado a Node por HTTP. La respuesta reúne el resultado de la operación y sus estadísticas. Devuelve 502 si falla la consulta a Node.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "matrix": {
                    "$ref": "#/components/schemas/Matrix"
                  },
                  "operation": {
                    "enum": [
                      "qr",
                      "rotate"
                    ]
                  }
                },
                "required": [
                  "matrix",
                  "operation"
                ]
              },
              "example": {
                "matrix": [
                  [
                    1,
                    2,
                    3
                  ],
                  [
                    4,
                    5,
                    6
                  ]
                ],
                "operation": "qr"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "operation": {
                      "enum": [
                        "qr",
                        "rotate"
                      ]
                    },
                    "result": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/QR"
                        },
                        {
                          "$ref": "#/components/schemas/Rotation"
                        }
                      ]
                    },
                    "statistics": {
                      "$ref": "#/components/schemas/Statistics"
                    }
                  },
                  "required": [
                    "operation",
                    "result",
                    "statistics"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds body limit",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid matrix or operation, or numeric overflow",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Statistics call failed",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/statistics": {
      "servers": [
        {
          "url": "http://statistics-api:3000",
          "description": "Compose private network"
        }
      ],
      "post": {
        "summary": "Calcular estadísticas de matrices (servicio interno)",
        "description": "Recibe una o más matrices. Devuelve máximo, mínimo, promedio y suma sobre todos sus elementos, y los índices de las matrices diagonales. Go llama a este endpoint por la red interna de Compose.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "matrices": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Matrix"
                    },
                    "minItems": 1,
                    "maxItems": 10
                  }
                },
                "required": [
                  "matrices"
                ]
              },
              "example": {
                "matrices": [
                  [
                    [
                      1,
                      0
                    ],
                    [
                      0,
                      2
                    ]
                  ],
                  [
                    [
                      3,
                      4
                    ],
                    [
                      5,
                      6
                    ]
                  ]
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Statistics"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds body limit",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid matrix or operation, or numeric overflow",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Matrix": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "minItems": 1,
        "maxItems": 100
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "QR": {
        "type": "object",
        "properties": {
          "q": {
            "$ref": "#/components/schemas/Matrix"
          },
          "r": {
            "$ref": "#/components/schemas/Matrix"
          },
          "shape": {
            "type": "object",
            "properties": {
              "rows": {
                "type": "integer"
              },
              "cols": {
                "type": "integer"
              }
            },
            "required": [
              "rows",
              "cols"
            ]
          },
          "convention": {
            "const": "thin"
          }
        },
        "required": [
          "q",
          "r",
          "shape",
          "convention"
        ]
      },
      "Rotation": {
        "type": "object",
        "properties": {
          "matrix": {
            "$ref": "#/components/schemas/Matrix"
          },
          "rotationDegrees": {
            "const": 90
          }
        },
        "required": [
          "matrix",
          "rotationDegrees"
        ]
      },
      "Statistics": {
        "type": "object",
        "properties": {
          "max": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "average": {
            "type": "number"
          },
          "sum": {
            "type": "number"
          },
          "anyDiagonal": {
            "type": "boolean"
          },
          "diagonalMatrices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "matrixCount": {
            "type": "integer"
          }
        },
        "required": [
          "max",
          "min",
          "average",
          "sum",
          "anyDiagonal",
          "diagonalMatrices",
          "matrixCount"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
